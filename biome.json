{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.claude/worktrees", "!.claude/skills", "!upstream"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noRedundantRoles": { "level": "error", "fix": "safe" }
      },
      "correctness": {
        "noUnusedImports": { "level": "warn", "fix": "safe" }
      },
      "suspicious": {
        "noDoubleEquals": { "level": "error", "fix": "safe" }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  }
}
