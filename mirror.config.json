{
  "namespace": "bje",
  "upstream": {
    "url": "https://ui.shadcn.com/r/styles/{style}/{name}.json",
    "colorsUrl": "https://ui.shadcn.com/r/colors/{name}.json",
    "style": "base-vega"
  },
  "theme": {
    "baseColor": "neutral",
    "font": "inter",
    "iconLibrary": "lucide"
  },
  "components": [
    "button",
    "button-group",
    "separator",
    "badge",
    "card",
    "alert",
    "label",
    "input",
    "textarea",
    "skeleton",
    "spinner",
    "kbd",
    "aspect-ratio",
    "table",
    "breadcrumb",
    "empty"
  ],
  "typeset": {
    "stylesheet": "https://ui.shadcn.com/typeset.css",
    "fixturesUrl": "https://raw.githubusercontent.com/shadcn-ui/ui/main/apps/v4/app/(app)/(typeset)/lib/fixtures/{name}.ts",
    "fixtures": ["docs", "chat", "changelog", "notes", "recipe", "elements"]
  },
  "snapshotDir": "upstream",
  "outputDir": "registry/ui",
  "globalsDir": "registry/styles",
  "harnessDir": "ab/generated",
  "consumerClasses": [
    {
      "classes": ["border-b", "border-t"],
      "reason": "Card header and footer pad only when given Tailwind's border-b or border-t, which no element carries here."
    }
  ]
}
