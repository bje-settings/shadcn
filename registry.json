{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "bje",
  "homepage": "https://github.com/bje-settings/shadcn",
  "items": [
    {
      "name": "cn",
      "type": "registry:lib",
      "title": "cn",
      "description": "Joins conditional class names with clsx.",
      "dependencies": ["clsx"],
      "files": [
        {
          "path": "registry/lib/cn.ts",
          "type": "registry:lib"
        }
      ]
    },
