          "type": "registry:ui"
        },
        {
          "path": "registry/ui/Button/Button.module.scss",
          "type": "registry:ui"
        },
        {
          "path": "registry/ui/Button/Button.test.tsx",
          "type": "registry:ui"
        }
      ]
    },
