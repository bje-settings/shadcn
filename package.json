{
  "name": "bje-shadcn-registry",
  "private": true,
  "type": "module",
  "description": "Source for the @bje shadcn registry.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "build": "shadcn build",
    "test": "vitest run --coverage",
    "mirror:fetch": "node scripts/mirror/main.ts fetch",
    "mirror:build": "node scripts/mirror/main.ts build",
    "ab": "playwright test --config ab/playwright.config.ts",
    "ab:serve": "vite --config ab/vite.config.ts --port 4400"
  },
  "dependencies": {
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/types": "7.29.8",
    "@base-ui/react": "1.8.0",
    "@biomejs/biome": "2.5.13",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "jsdom": "30.1.1",
    "lefthook": "2.1.12",
    "lucide-react": "1.48.0",
    "magic-string": "1.4.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "1.105.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "ts-morph": "26.0.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
